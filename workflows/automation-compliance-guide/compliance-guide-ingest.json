      "position": [
        160,
        -48
      ]
    },
    {
      "parameters": {
        "content": "## Extract from File\n### What happens:\n- Turns the JSON file into data.\n### Why:\n- n8n cannot work with a raw file.\n### Output:\n- `data` (list of all cards)\n### Settings:\n- Operation: Extract From JSON.",
        "height": 470,
        "width": 276,
        "color": "#F09999"
      },
      "id": "3f763515-6ba7-4d7d-a370-77b354aebe26",
